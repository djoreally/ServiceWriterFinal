# Public Next.js configuration
NEXT_PUBLIC_APP_NAME=Service Writer
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CORS_ORIGIN=http://localhost:3000

# One canonical Supabase project for auth, data, storage, functions, and realtime.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PROJECT_ID=your-project-ref
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@servicewriter.xyz
CRON_SECRET=replace-with-a-long-random-vercel-cron-secret

# Primary transactional application email provider.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SIGNING_SECRET=

# Growth/marketing email provider and controlled transactional fallback when
# Resend rejects/fails before provider acceptance.
ENGINEMAILER_API_KEY=
ENGINEMAILER_FROM_EMAIL=
ENGINEMAILER_WEBHOOK_SIGNING_SECRET=
# Optional least-privilege Enginemailer key and sender-identity overrides.
ENGINEMAILER_TRANSACTIONAL_API_KEY=
ENGINEMAILER_TRANSACTIONAL_FROM_EMAIL=
ENGINEMAILER_MARKETING_FROM_EMAIL=
# Optional comma-separated Enginemailer subcategory IDs for synced subscribers.
ENGINEMAILER_MARKETING_SUBCATEGORY_IDS=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
