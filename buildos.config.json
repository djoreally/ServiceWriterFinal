{
  "version": 1,
  "stateDirectory": ".buildos",
  "agentContract": "AGENTS.md",
  "specification": "BUILDOS.md",
  "commands": {
    "typecheck": "npm run typecheck",
    "lint": "npm run lint:strict",
    "test": "npm test -- --runInBand",
    "build": "npm run build",
    "architecture": "npm run verify:architecture",
    "identity": "npm run verify:identity"
  },
  "check": ["state", "typecheck", "lint", "architecture", "identity"],
  "verify": ["state", "typecheck", "lint", "architecture", "identity", "test", "build"],
  "requireChangeRecord": true,
  "release": {
    "requireCleanTree": true,
    "requireExactSha": true
  }
}
