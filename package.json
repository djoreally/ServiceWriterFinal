{
  "name": "service-writer-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify:boundaries": "node scripts/verify-client-boundaries.mjs",
    "email:build": "npx react-email@2.1.0 build",
    "email:dev": "npx react-email@2.1.0 dev --dir ./src/features/emails --port 3001",
    "email:export": "npx react-email@2.1.0 export",
    "generate-types": "npx supabase gen types typescript --project-id $SUPABASE_PROJECT_ID --schema public > src/libs/supabase/types.ts",
    "supabase:link": "npx env-cmd@10.1.0 -f ./.env.local npx supabase@1.145.4 link --project-ref $SUPABASE_PROJECT_ID",
    "migration:new": "npx supabase@1.145.4 migration new",
    "migration:up": "npx supabase@1.145.4 migration up --linked --debug && npm run generate-types",
    "migration:squash": "npx supabase@1.145.4 migration squash --linked",
    "drizzle:generate": "npx drizzle-kit@0.31.4 generate",
    "drizzle:check": "npx drizzle-kit@0.31.4 check",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/v1/webhooks/stripe",
    "stripe:trigger:payment-succeeded": "stripe trigger payment_intent.succeeded"
  },
  "dependencies": {
    "@react-email/components": "0.0.15",
    "@supabase/supabase-js": "2.39.0",
    "drizzle-orm": "^0.44.5",
    "next": "14.0.4",
    "postgres": "^3.4.7",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "resend": "3.2.0",
    "zod": "3.22.4",
    "stripe": "18.5.0",
    "hono": "^4.9.7",
    "@hono/zod-validator": "^0.7.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/react": "18.2.43",
    "@types/react-dom": "18.2.18",
    "eslint": "8.55.0",
    "eslint-config-next": "14.0.4",
    "typescript": "5.3.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
