{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci && npm audit fix --package-lock-only && git diff -- package-lock.json",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/internal/lifecycle/outbox",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/internal/notifications/push/outbox",
      "schedule": "*/5 * * * *"
    }
  ]
}
