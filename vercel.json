{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "bash scripts/secure-npm-install.sh",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/internal/lifecycle/outbox",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/internal/notifications/push/outbox",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/internal/crm/newsletter/weekly",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/internal/reports/morning-read",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/internal/carfax/daily",
      "schedule": "30 6 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  }
}
